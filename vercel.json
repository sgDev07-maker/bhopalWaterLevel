{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "https://userauth.revolutioninfosystems.com/api/UserAuthAPI/valuser"
    },
    {
      "source": "/api/auth/change-password",
      "destination": "https://userauth.revolutioninfosystems.com/api/UserAuthAPI/changepass"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
