{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/analog/tagapi/gettagsbyid.js": {
      "maxDuration": 30
    },
    "api/analog/tagapi/gettagdatabydate.js": {
      "maxDuration": 30
    },
    "api/analog-proxy.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "https://userauth.revolutioninfosystems.com/api/UserAuthAPI/valuser"
    },
    {
      "source": "/api/auth/change-password",
      "destination": "https://userauth.revolutioninfosystems.com/api/UserAuthAPI/changepass"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
