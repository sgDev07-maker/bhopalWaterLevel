{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/analog-proxy.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "https://userauth.revolutioninfosystems.com/api/UserAuthAPI/valuser"
    },
    {
      "source": "/api/auth/change-password",
      "destination": "https://userauth.revolutioninfosystems.com/api/UserAuthAPI/changepass"
    },
    {
      "source": "/api/analog/:path*",
      "destination": "/api/analog-proxy?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
